# Variables del build que empaqueta Capacitor (`vite build --mode native`).
# Ninguna es secreta: la URL es publica y las claves de Supabase siguen
# viniendo de .env.local / .env.production, que no se versionan.
#
# Dentro del APK el frontend ya no comparte dominio con la API, asi que las
# rutas relativas /api/... no resuelven. Esta variable las reescribe contra
# el despliegue de produccion en Vercel.
VITE_API_BASE_URL=https://rumbo-web-sepia.vercel.app
