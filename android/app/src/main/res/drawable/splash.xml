<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de arranque: mismo crema del tema de la app con el logo centrado,
  para que el salto al WebView no se note. Reemplaza al splash.png de ejemplo
  que trae Capacitor.
-->
